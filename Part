local function stopEffect()
	currentEffect = nil
	Status.Text = "Effect: None"
	blackHoleHolding = false
	tornadoHolding = false
	clickTpMode = false

	if effectConnection then
		effectConnection:Disconnect()
		effectConnection = nil
	end

	ControlFrame.Visible = false
	for _, child in ipairs(ControlsHolder:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	for _, conn in ipairs(activeControlConnections) do conn:Disconnect() end
	table.clear(activeControlConnections)
	table.clear(effectParams)

	for part in pairs(Network.BaseParts) do
		if part and part.Parent and not part.Anchored then
			pcall(function()
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end)
		end
	end
end

