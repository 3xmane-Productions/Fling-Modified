local function getParts()
	local valid = {}
	local myPos = HRP and HRP.Position or Vector3.zero
	for part in pairs(Network.BaseParts) do
		if part and part.Parent and not part.Anchored and not part:IsDescendantOf(Character) then
			if (part.Position - myPos).Magnitude <= 2500 then table.insert(valid, part) end
		end
	end
	return valid
end

local mouse = LocalPlayer:GetMouse()
local function getMouseTarget()
	local ray = workspace.CurrentCamera:ScreenPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filterList = {Character}
	if selectedPlayer and selectedPlayer.Character then table.insert(filterList, selectedPlayer.Character) end
	for part in pairs(Network.BaseParts) do table.insert(filterList, part) end
	params.FilterDescendantsInstances = filterList

	local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	return result and result.Position or ray.Origin + (ray.Direction * 150)
end

