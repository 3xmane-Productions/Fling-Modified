local function startEffect(name, func, setupControlsCallback)
	if currentEffect == name then
		stopEffect()
		return
	end
	stopEffect()
	currentEffect = name
	Status.Text = "Effect: " .. name
	if setupControlsCallback then setupControlsCallback() end
	effectConnection = RunService.Heartbeat:Connect(func)
end

local function getTargetHRP()
	if selectedPlayer and selectedPlayer.Character then
		local hum = selectedPlayer.Character:FindFirstChildOfClass("Humanoid")
		local hrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
		if hrp and hum and hum.Health > 0 then return hrp end
	elseif Character then
		local hum = Character:FindFirstChildOfClass("Humanoid")
		if HRP and hum and hum.Health > 0 then return HRP end
	end
	return nil
end

