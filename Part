----------------------------------------------------
-- EFFECT SYSTEM (DESACTIVACIÓN Y LIMPIEZA COMPLETA)
----------------------------------------------------

local function stopEffect()
	currentEffect = nil
	Status.Text = "Effect: None"

	blackHoleHolding = false
	tornadoHolding = false
	clickTpMode = false

	if effectConnection then
		effectConnection:Disconnect()
		effectConnection = nil
	end

	-- Limpieza de inercia al cambiar o detener cualquier efecto
	for part in pairs(Network.BaseParts) do
		if part and part.Parent and not part.Anchored then
			pcall(function()
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end)
		end
	end
end

local function startEffect(name, func)
	if currentEffect == name then
		stopEffect()
		return
	end

	stopEffect()
	currentEffect = name
	Status.Text = "Effect: " .. name
	effectConnection = RunService.Heartbeat:Connect(func)
end

