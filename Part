				localPos = Vector3.new(0, y, 0)
			else
				local t = (i - vertCount - 1) / math.max(1, (total - vertCount) - 1)
				local x = (-0.7 + (t * 1.4)) * (sep * 0.05)
				local y = -0.3 * (sep * 0.05)
				localPos = Vector3.new(x, y, 0)
			end
			
			local rotated = CFrame.Angles(0, invCrossTick, 0) * localPos
			local targetPos = targetHRP.Position + Vector3.new(0, (targetHRP.Size.Y / 2) + height, 0) + rotated
			part.AssemblyLinearVelocity = (targetPos - part.Position) * 16
		end
	end, function()
