local targetAllTick = 0
local currentTargetIndex = 1

createButton("Target All", Color3.fromRGB(200, 30, 80)).MouseButton1Click:Connect(function()
	startEffect("Target All", function()
		local now = tick()
		local validTargets = {}

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")

				if hum and hrp and hum.Health > 0 then
					local vel = hrp.AssemblyLinearVelocity.Magnitude
					if vel < 150 and math.abs(hrp.Position.Y) < 1000 then
						table.insert(validTargets, hrp)
					end
				end
			end
		end

		if #validTargets == 0 then return end

		if now - targetAllTick >= 0.3 then
			targetAllTick = now
			currentTargetIndex = (currentTargetIndex % #validTargets) + 1
		end

		local currentTargetHRP = validTargets[currentTargetIndex] or validTargets[1]
		if not currentTargetHRP then return end

		for _, part in ipairs(getParts()) do
			if not part or not part.Parent or part.Anchored or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
				continue
			end

			local model = part:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then continue end
			if part.AssemblyMass > 10000 then continue end

			pcall(function()
				local offset = Vector3.new(
					math.random(-5, 5),
					math.random(-2, 4),
					math.random(-5, 5)
				)
				local targetPos = currentTargetHRP.Position + offset

				part.CFrame = CFrame.new(targetPos)
				part.AssemblyLinearVelocity = (targetPos - part.Position) * 120
				part.AssemblyAngularVelocity = Vector3.new(350, 350, 350)
			end)
		end
	end)
end)

