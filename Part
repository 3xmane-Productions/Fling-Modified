-- BLACK HOLE
----------------------------------------------------

local blackHoleHolding = false

local BlackHoleButton = createButton("Black Hole", Color3.fromRGB(20, 20, 20))

BlackHoleButton.MouseButton1Click:Connect(function()
	blackHoleHolding = true
	Status.Text = "Effect: Hold Click For Black Hole"
end)

mouse.Button1Down:Connect(function()
	if not blackHoleHolding then return end

	startEffect("Black Hole", function()
		local bhPos = getMouseTarget()
		local t = tick() * 15

		for _, part in ipairs(getParts()) do
			if not part or not part.Parent or part.Anchored or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
				continue
			end

			local model = part:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then continue end
			if part.AssemblyMass > 10000 then continue end

			local diff = bhPos - part.Position
			local dist = diff.Magnitude

			if dist > 2.0 then
				local pullForce = diff * 30
				local angleX = math.cos(t + part.Position.X) * 80
				local angleZ = math.sin(t + part.Position.Z) * 80
				local spiral = Vector3.new(angleX, math.sin(t) * 50, angleZ)

				part.AssemblyLinearVelocity = pullForce + spiral
			else
				part.AssemblyLinearVelocity = Vector3.new(
					math.random(-15, 15),
					math.random(-15, 15),
					math.random(-15, 15)
				)
			end

			part.AssemblyAngularVelocity = Vector3.new(15, 45, 15)
		end
	end)
end)

mouse.Button1Up:Connect(function()
	if currentEffect == "Black Hole" then
		stopEffect()
		blackHoleHolding = false
	end
end)

