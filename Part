		for i, part in ipairs(parts) do
			local y = 1 - (i / total) * 2
			local r = math.sqrt(1 - y * y) * radius
			local theta = phi * i + (sphereTick * 2.5)
			local localPos = Vector3.new(math.cos(theta) * r, y * radius, math.sin(theta) * r)
			part.AssemblyLinearVelocity = ((targetHRP.Position + localPos) - part.Position) * 18
		end
	end, function()
