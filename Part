local starTick = 0
createButton(HolderEffects, "Star", Color3.fromRGB(255, 255, 0)).MouseButton1Click:Connect(function()
	startEffect("Star", function()
		local targetHRP = getTargetHRP()
		if not targetHRP then return end
		starTick += (0.02 * effectParams["Rotacion"])
		local parts = getParts()
		local sep = effectParams["Separacion"]
		local height = effectParams["Altura Cabeza"]
		local total = #parts
		if total == 0 then return end
		
		local points = {}
		local outerRadius = sep
		local innerRadius = sep * 0.4
		for i = 0, 9 do
			local r = (i % 2 == 0) and outerRadius or innerRadius
			local angle = math.rad((i * 36) - 90)
			table.insert(points, Vector3.new(math.cos(angle) * r, -math.sin(angle) * r, 0))
		end
		
		for i, part in ipairs(parts) do
			local progress = (i / total) * 10
			local segment = math.floor(progress)
			local t = progress - segment
			
			local p1 = points[(segment % 10) + 1]
			local p2 = points[((segment + 1) % 10) + 1]
			local localPos = p1:Lerp(p2, t)
			
			local rotated = CFrame.Angles(0, starTick, 0) * localPos
			local targetPos = targetHRP.Position + Vector3.new(0, (targetHRP.Size.Y / 2) + height, 0) + rotated
			part.AssemblyLinearVelocity = (targetPos - part.Position) * 15
		end
	end, function()
		AddControl("Altura Cabeza", -100, 100, 30)
		AddControl("Separacion", -200, 200, 50)
		AddControl("Rotacion", -20, 20, 1)
	end)
end)

