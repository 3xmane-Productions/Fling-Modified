local function getWireframePoint(vertices, edges, progress)
	local totalEdges = #edges
	if totalEdges == 0 then return Vector3.zero end
	local floatEdge = (progress % 1) * totalEdges
	local edgeIdx = math.clamp(math.floor(floatEdge) + 1, 1, totalEdges)
	local edgeAlpha = floatEdge - math.floor(floatEdge)
	
	local edge = edges[edgeIdx]
	local v1 = vertices[edge[1]]
	local v2 = vertices[edge[2]]
	return v1:Lerp(v2, edgeAlpha)
end

