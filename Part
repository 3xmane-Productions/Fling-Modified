local CONFIG_FILE = "PhysicsGuiSettings.json"

local function loadSavedSettings()
	if isfile and readfile and isfile(CONFIG_FILE) then
		local success, data = pcall(function()
			return HttpService:JSONDecode(readfile(CONFIG_FILE))
		end)
		if success and type(data) == "table" then return data end
	end
	return getgenv().SavedPhysicsParams or {}
end

local savedParams = loadSavedSettings()

local function saveSettings()
	getgenv().SavedPhysicsParams = savedParams
	if writefile then
		pcall(function()
			writefile(CONFIG_FILE, HttpService:JSONEncode(savedParams))
		end)
	end
end

