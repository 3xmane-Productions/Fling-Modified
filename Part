-- MOUSE EVENT LISTENERS (CLICK TP, BLACK HOLE, TORNADO)
----------------------------------------------------

local bhTick = 0

mouse.Button1Down:Connect(function()
	-- Mode: Click TP
	if clickTpMode then
		clickTpMode = false
		local targetPosition = getMouseTarget()

		for _, part in ipairs(getParts()) do
			if not part or not part.Parent or part.Anchored or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
				continue
			end

			local model = part:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then continue end
			if part.AssemblyMass > 10000 then continue end

			pcall(function()
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
				part.CFrame = CFrame.new(
					targetPosition + Vector3.new(
						math.random(-4, 4),
						math.random(-4, 4),
						math.random(-4, 4)
					)
				)
			end)
		end

		Status.Text = "Effect: None"
		return
	end

	-- Mode: Black Hole (TP Ultra Agresivo y Centro Ultra Denso)
	if blackHoleHolding then
		startEffect("Black Hole", function()
			local bhPos = getMouseTarget()
			bhTick += 0.2 
			local parts = getParts()

			for i, part in ipairs(parts) do
				if not part or not part.Parent or part.Anchored or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
					continue
				end

				local model = part:FindFirstAncestorOfClass("Model")
				if model and model:FindFirstChildOfClass("Humanoid") then continue end
				if part.AssemblyMass > 10000 then continue end

				pcall(function()
					local diff = bhPos - part.Position
					local dist = diff.Magnitude

					if dist > 12 then
						-- Avance directo tipo Teleport rápido al centro
						part.CFrame = CFrame.new(part.Position:Lerp(bhPos, 0.45))
						part.AssemblyLinearVelocity = diff.Unit * 450 + Vector3.new(math.random(-30, 30), math.random(-30, 30), math.random(-30, 30))
					else
						-- Centro ultra compacto, sin dispersión
						local angle = bhTick + (i * 0.15)
						local radius = math.clamp(dist, 0.5, 3.5)
						local orbitOffset = Vector3.new(
							math.cos(angle) * radius,
							math.sin(bhTick * 2 + i) * 1.5,
							math.sin(angle) * radius
						)
						local targetPos = bhPos + orbitOffset
						
						part.CFrame = CFrame.new(part.Position:Lerp(targetPos, 0.6))
						part.AssemblyLinearVelocity = (targetPos - part.Position) * 50
					end

					part.AssemblyAngularVelocity = Vector3.new(400, 500, 400)
				end)
			end
		end)
		return
	end

	-- Mode: Tornado
	if tornadoHolding then
		startEffect("Tornado", function()
			local mousePos = getMouseTarget()
			if not mousePos then return end

			tornadoTick += 0.18
			local parts = getParts()
			local total = #parts
			if total == 0 then return end

			local maxHeight = 140
			local baseRadius = 12
			local topRadius = 95

			for i, part in ipairs(parts) do
				if not part or not part.Parent or part.Anchored or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
					continue
				end

				local model = part:FindFirstAncestorOfClass("Model")
				if model and model:FindFirstChildOfClass("Humanoid") then continue end
				if part.AssemblyMass > 10000 then continue end

				pcall(function()
					local progress = (i / total)
					local currentHeight = progress * maxHeight
					local currentRadius = baseRadius + (progress * (topRadius - baseRadius))

					local angle = tornadoTick * 4 + (progress * math.pi * 4) + (i * 0.1)
					
					local offset = Vector3.new(
						math.cos(angle) * currentRadius,
						currentHeight - 20,
						math.sin(angle) * currentRadius
					)

					local targetPos = mousePos + offset

					part.AssemblyLinearVelocity = (targetPos - part.Position) * 40
					part.AssemblyAngularVelocity = Vector3.new(0, 320, 0)
				end)
			end
		end)
		return
	end
end)

