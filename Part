local function findPlayer(str)
	str = string.lower(str)
	for _, plr in ipairs(Players:GetPlayers()) do
		if string.sub(string.lower(plr.Name), 1, #str) == str or string.sub(string.lower(plr.DisplayName), 1, #str) == str then
			return plr
		end
	end
	return nil
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local text = SearchBox.Text
	if text == "" then
		selectedPlayer = nil
		TargetStatus.Text = "Target: Yourself"
		return
	end

	local found = findPlayer(text)
	if found then
		selectedPlayer = found
		TargetStatus.Text = "Target: " .. found.Name
	else
		selectedPlayer = nil
		TargetStatus.Text = "Target: Not Found"
	end
end)

local playerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
	if plr == selectedPlayer then
