----------------------------------------------------
-- NETWORK / PART CONTROL (OPTIMIZADO PARA ANCHORED)
----------------------------------------------------

getgenv().Network = getgenv().Network or {
	BaseParts = {}
}

local Network = getgenv().Network

local function retainPart(part)
	if not part:IsA("BasePart") then return end
	if not part:IsDescendantOf(workspace) then return end
	if part:IsDescendantOf(Character) then return end
	if part.Anchored then return end
	if Network.BaseParts[part] then return end

	Network.BaseParts[part] = true

	pcall(function()
		part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
	end)
end

for _, v in ipairs(workspace:GetDescendants()) do
	retainPart(v)
end

local descendantConn = workspace.DescendantAdded:Connect(retainPart)

local lastScan = 0
local scanConn = RunService.Stepped:Connect(function(time)
	if time - lastScan >= 1.5 then
		lastScan = time
		for _, v in ipairs(workspace:GetDescendants()) do
			if v:IsA("BasePart") and not v.Anchored and not Network.BaseParts[v] then
				retainPart(v)
			end
		end
	end
end)

----------------------------------------------------
-- KEEP NETWORK OWNERSHIP & REPLICATION
----------------------------------------------------

local networkConn = RunService.Heartbeat:Connect(function()
	pcall(function()
		sethiddenproperty(LocalPlayer, "SimulationRadius", 100000)
		sethiddenproperty(LocalPlayer, "MaxSimulationRadius", 100000)
	end)

	for part in pairs(Network.BaseParts) do
		if not part or not part.Parent or not part:IsDescendantOf(workspace) or part.Anchored then
			Network.BaseParts[part] = nil
		else
			pcall(function()
				if part.AssemblyLinearVelocity.Magnitude < 0.01 then
					part.AssemblyLinearVelocity = Vector3.new(0, 0.05, 0)
				end
			end)
		end
	end
end)

