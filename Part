local bhTick, tornadoTick = 0, 0

mouse.Button1Down:Connect(function()
	if clickTpMode then
		clickTpMode = false
		local targetPosition = getMouseTarget()
		for _, part in ipairs(getParts()) do
			pcall(function()
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
				part.CFrame = CFrame.new(targetPosition + Vector3.new(math.random(-4, 4), math.random(-4, 4), math.random(-4, 4)))
			end)
		end
		Status.Text = "Effect: None"
		return
	end

	if blackHoleHolding then
		startEffect("Black Hole", function()
			local bhPos = getMouseTarget()
			bhTick += 0.2 
			for i, part in ipairs(getParts()) do
				pcall(function()
					local diff = bhPos - part.Position
					local dist = diff.Magnitude
					if dist > 12 then
						part.CFrame = CFrame.new(part.Position:Lerp(bhPos, 0.45))
						part.AssemblyLinearVelocity = diff.Unit * 450 + Vector3.new(math.random(-30,30), math.random(-30,30), math.random(-30,30))
					else
						local angle = bhTick + (i * 0.15)
						local r = math.clamp(dist, 0.5, 3.5)
						local targetPos = bhPos + Vector3.new(math.cos(angle)*r, math.sin(bhTick*2+i)*1.5, math.sin(angle)*r)
						part.CFrame = CFrame.new(part.Position:Lerp(targetPos, 0.6))
						part.AssemblyLinearVelocity = (targetPos - part.Position) * 50
					end
					part.AssemblyAngularVelocity = Vector3.new(400, 500, 400)
				end)
			end
		end)
	end

	if tornadoHolding then
		startEffect("Tornado", function()
			local mousePos = getMouseTarget()
			if not mousePos then return end
			tornadoTick += 0.18
			local parts = getParts()
			local total = #parts
			for i, part in ipairs(parts) do
				pcall(function()
					local p = (i / total)
					local currentHeight = p * 140
					local currentRadius = 12 + (p * 83)
					local angle = tornadoTick * 4 + (p * math.pi * 4) + (i * 0.1)
					local targetPos = mousePos + Vector3.new(math.cos(angle)*currentRadius, currentHeight - 20, math.sin(angle)*currentRadius)
					part.AssemblyLinearVelocity = (targetPos - part.Position) * 40
					part.AssemblyAngularVelocity = Vector3.new(0, 320, 0)
				end)
			end
		end)
	end
end)

