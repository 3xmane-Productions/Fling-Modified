createButton(HolderEffects, "Inverted Cross", Color3.fromRGB(150, 0, 0)).MouseButton1Click:Connect(function()
	startEffect("Inverted Cross", function()
		local targetHRP = getTargetHRP()
		if not targetHRP then return end
		invCrossTick += (0.02 * effectParams["Rotacion"])
		local parts = getParts()
		local sep = effectParams["Separacion"]
		local height = effectParams["Altura Cabeza"]
