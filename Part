----------------------------------------------------
-- CUBE (GIGANTE Y AMPLIAMENTE ESPACIADO)
----------------------------------------------------

createButton("Cube", Color3.fromRGB(150, 80, 255)).MouseButton1Click:Connect(function()
	startEffect("Cube", function()
		local targetHRP = getTargetHRP()
		if not targetHRP then return end

		local parts = getParts()
		local total = #parts
		if total == 0 then return end

		local size = 55
		local partsPerFace = math.max(1, math.floor(total / 6))
		local sideCount = math.max(1, math.ceil(math.sqrt(partsPerFace)))

		for i, part in ipairs(parts) do
			local faceIndex = math.min(6, math.floor((i - 1) / partsPerFace) + 1)
			local localIdx = (i - 1) % partsPerFace

			local u = ((localIdx % sideCount) / math.max(1, sideCount - 1)) - 0.5
			local v = ((math.floor(localIdx / sideCount) / math.max(1, sideCount - 1))) - 0.5
			u = u * (size * 2.8)
			v = v * (size * 2.8)

			local localPos = Vector3.zero
			if faceIndex == 1 then localPos = Vector3.new(u, v, size)
			elseif faceIndex == 2 then localPos = Vector3.new(u, v, -size)
			elseif faceIndex == 3 then localPos = Vector3.new(-size, u, v)
			elseif faceIndex == 4 then localPos = Vector3.new(size, u, v)
			elseif faceIndex == 5 then localPos = Vector3.new(u, size, v)
			elseif faceIndex == 6 then localPos = Vector3.new(u, -size, v)
			end

			local targetPos = targetHRP.Position + localPos

			part.AssemblyLinearVelocity = (targetPos - part.Position) * 12
			part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end)
end)

----------------------------------------------------
-- WINGS (ESTRICTAMENTE ATRÁS, GRAN SEPARACIÓN Y ALETAZO FLUIDO)
----------------------------------------------------

local wingTick = 0

createButton("Wings", Color3.fromRGB(0, 180, 255)).MouseButton1Click:Connect(function()
	startEffect("Wings", function()
		local targetHRP = getTargetHRP()
		if not targetHRP then return end

		wingTick += 0.05
		local parts = getParts()
		local total = #parts
		if total == 0 then return end

		local halfTotal = math.max(1, math.floor(total / 2))

		for i, part in ipairs(parts) do
			local isRight = i <= halfTotal
			local localIndex = isRight and i or (i - halfTotal)
			local ratio = localIndex / halfTotal

			local sideMultiplier = isRight and 1 or -1
			
			-- Movimiento de aleteo dinámico y elegante
			local wingFlapY = math.sin(wingTick + (ratio * math.pi * 1.5)) * (14 * ratio)
			local wingFlapZ = math.cos(wingTick + (ratio * math.pi)) * (6 * ratio)

			-- Gran separación lateral, altura y posicionadas DETRÁS (+Z)
			local spanWidth = 10 + (ratio * 55)
			local spanHeight = 3 + (ratio * 32) + wingFlapY
			local depthZ = 14 + (ratio * 20) + wingFlapZ

			local offsetX = spanWidth * sideMultiplier
			local offsetY = spanHeight
			local offsetZ = depthZ

			local targetCFrame = targetHRP.CFrame * CFrame.new(offsetX, offsetY, offsetZ)
			local targetPos = targetCFrame.Position

			part.AssemblyLinearVelocity = (targetPos - part.Position) * 15
			part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end)
end)

