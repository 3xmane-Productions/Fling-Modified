			local ratio = (isRight and i or (i - halfTotal)) / halfTotal
			local side = isRight and 1 or -1
			local wY = math.sin(wingTick + (ratio * math.pi * 1.2)) * (60 * ratio)
			local wZ = math.cos(wingTick + (ratio * math.pi)) * (30 * ratio)
			local targetPos = targetHRP.CFrame * CFrame.new((20 + ratio * 110) * side, 5 + ratio * 60 + wY, 35 + ratio * 40 + wZ)
			part.AssemblyLinearVelocity = (targetPos.Position - part.Position) * 16
		end
	end, function()
