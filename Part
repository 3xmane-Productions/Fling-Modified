local function AddControl(paramName, minVal, softMax, defaultVal)
	ControlFrame.Visible = true

	if not savedParams[currentEffect] then savedParams[currentEffect] = {} end
	local valToUse = savedParams[currentEffect][paramName]
	if valToUse == nil then valToUse = defaultVal end
	effectParams[paramName] = valToUse

	local Container = Instance.new("Frame", ControlsHolder)
	Container.Size = UDim2.new(1, 0, 0, 45)
	Container.BackgroundTransparency = 1

	local Label = Instance.new("TextLabel", Container)
	Label.Size = UDim2.new(0.6, 0, 0, 18)
	Label.BackgroundTransparency = 1
	Label.Text = paramName
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 12
	Label.TextColor3 = Color3.new(1, 1, 1)
	Label.TextXAlignment = Enum.TextXAlignment.Left

	local Input = Instance.new("TextBox", Container)
	Input.Size = UDim2.new(0.35, 0, 0, 18)
	Input.Position = UDim2.new(0.65, 0, 0, 0)
	Input.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	Input.Text = tostring(valToUse)
	Input.Font = Enum.Font.Gotham
	Input.TextSize = 11
	Input.TextColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", Input).CornerRadius = UDim.new(0, 4)

	local SliderBG = Instance.new("Frame", Container)
	SliderBG.Size = UDim2.new(1, 0, 0, 6)
	SliderBG.Position = UDim2.new(0, 0, 0, 25)
	SliderBG.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	Instance.new("UICorner", SliderBG).CornerRadius = UDim.new(1, 0)

	local SliderBtn = Instance.new("TextButton", SliderBG)
	SliderBtn.Size = UDim2.new(0, 12, 0, 12)
	SliderBtn.AnchorPoint = Vector2.new(0.5, 0.5)
	
	local initialPercent = math.clamp((valToUse - minVal) / (softMax - minVal), 0, 1)
	SliderBtn.Position = UDim2.new(initialPercent, 0, 0.5, 0)
	SliderBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
	SliderBtn.Text = ""
	Instance.new("UICorner", SliderBtn).CornerRadius = UDim.new(1, 0)

	local isDragging = false
	table.insert(activeControlConnections, SliderBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = true end
	end))

	table.insert(activeControlConnections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = false end
	end))

	table.insert(activeControlConnections, RunService.RenderStepped:Connect(function()
		if isDragging then
			local mousePos = UserInputService:GetMouseLocation().X
			local barAbs = SliderBG.AbsolutePosition.X
			local barSize = SliderBG.AbsoluteSize.X
			if barSize > 0 then
				local p = math.clamp((mousePos - barAbs) / barSize, 0, 1)
				local val = minVal + (p * (softMax - minVal))
				val = math.floor(val * 100) / 100 -- Alta precisión para movimientos fluidos
				
				SliderBtn.Position = UDim2.new(p, 0, 0.5, 0)
				Input.Text = tostring(val)
				effectParams[paramName] = val
				savedParams[currentEffect][paramName] = val
				saveSettings()
			end
		end
	end))

	-- Al dar click limpia el texto, y si se deja vacío pone 0 automáticamente
	table.insert(activeControlConnections, Input.Focused:Connect(function()
		Input.Text = ""
	end))

	table.insert(activeControlConnections, Input.FocusLost:Connect(function()
		local num = tonumber(Input.Text)
		if not num or Input.Text == "" then
			num = 0
		end
		Input.Text = tostring(num)
		effectParams[paramName] = num
		savedParams[currentEffect][paramName] = num
		saveSettings()

		local p = math.clamp((num - minVal) / (softMax - minVal), 0, 1)
		SliderBtn.Position = UDim2.new(p, 0, 0.5, 0)
	end))
end

