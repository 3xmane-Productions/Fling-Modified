----------------------------------------------------
-- SPHERE (Gigante y Rotación Fluida)
----------------------------------------------------

local sphereTick = 0

createButton("Sphere", Color3.fromRGB(150, 80, 255)).MouseButton1Click:Connect(function()
	startEffect("Sphere", function()
		local targetHRP = getTargetHRP()
		if not targetHRP then return end

		sphereTick += 0.015
		local parts = getParts()
		local total = #parts
		if total == 0 then return end

		local radius = 180
		local phi = math.pi * (3 - math.sqrt(5))

		for i, part in ipairs(parts) do
			local y = 1 - (i / total) * 2
			local r = math.sqrt(1 - y * y) * radius
			local theta = phi * i + (sphereTick * 2.5)

			local localPos = Vector3.new(math.cos(theta) * r, y * radius, math.sin(theta) * r)
			local targetPos = targetHRP.Position + localPos

			part.AssemblyLinearVelocity = (targetPos - part.Position) * 18
			part.AssemblyAngularVelocity = Vector3.new(12, 12, 12)
		end
	end)
end)

----------------------------------------------------
-- WINGS (Aleteo Extenso, Pausado y Partes Separadas)
----------------------------------------------------

local wingTick = 0

createButton("Wings", Color3.fromRGB(0, 180, 255)).MouseButton1Click:Connect(function()
	startEffect("Wings", function()
		local targetHRP = getTargetHRP()
		if not targetHRP then return end

		wingTick += 0.035 -- Aleteo pausado/elegante
		local parts = getParts()
		local total = #parts
		if total == 0 then return end

		local halfTotal = math.max(1, math.floor(total / 2))

		for i, part in ipairs(parts) do
			local isRight = i <= halfTotal
			local localIndex = isRight and i or (i - halfTotal)
			local ratio = localIndex / halfTotal

			local sideMultiplier = isRight and 1 or -1
			
			-- Movimiento de aleteo mucho más extenso
			local wingFlapY = math.sin(wingTick + (ratio * math.pi * 1.2)) * (60 * ratio)
			local wingFlapZ = math.cos(wingTick + (ratio * math.pi)) * (30 * ratio)

			-- Separación masiva entre partes
			local spanWidth = 20 + (ratio * 110)
			local spanHeight = 5 + (ratio * 60) + wingFlapY
			local depthZ = 35 + (ratio * 40) + wingFlapZ

			local offsetX = spanWidth * sideMultiplier
			local offsetY = spanHeight
			local offsetZ = depthZ

			local targetCFrame = targetHRP.CFrame * CFrame.new(offsetX, offsetY, offsetZ)
			local targetPos = targetCFrame.Position

			part.AssemblyLinearVelocity = (targetPos - part.Position) * 16
			part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end)
end)

